# The Saathi API, appended once to /etc/caddy/Caddyfile by selfhost/deploy-vps.sh.
# __API_HOST__ is substituted at deploy time from $SAATHI_API_HOST, so pointing a deploy at a
# staging host does not silently write a site block for the production name.
#
# Only the API is here. The saathi.dev website is a separate repository and is not part of the
# open-source project — self-hosting Saathi means running the backend, not the marketing page.

__API_HOST__ {
	encode gzip
	reverse_proxy 127.0.0.1:8787 {
		# The companion streams; buffering a stream defeats the point of streaming it.
		flush_interval -1
		transport http {
			read_timeout 10m
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
}
